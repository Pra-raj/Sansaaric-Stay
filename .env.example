# Django
# Fail-closed: startup raises if DJANGO_SECRET_KEY is missing or a placeholder.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change_me
# DEBUG is OFF by default; set to 1 explicitly for local development.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL (pgvector)
SUPABASE_DB_HOST=db.<your-project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your_db_password>
# sslmode for the Postgres connection. "require" (default) is right for
# Supabase; set "prefer" or "disable" for local/CI test databases.
SUPABASE_DB_SSLMODE=require

# Supabase S3-compatible storage
SUPABASE_S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=<your_s3_access_key>
SUPABASE_S3_SECRET_KEY=<your_s3_secret_key>
SUPABASE_S3_BUCKET=document
SUPABASE_S3_REGION=us-east-1

# AI providers
GROQ_API_KEY=change_me
COHERE_API_KEY=change_me

# Supabase Auth (GoTrue)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key from dashboard>
SUPABASE_JWT_AUDIENCE=authenticated
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser origin used inside password-reset emails
# (e.g. https://sansaaricstay.com). Defaults to http://localhost:3000.
# FRONTEND_URL=http://localhost:3000
#
# Transactional email. The default (console) backend prints messages in the
# Django terminal, which is fine for development. For real delivery use SMTP:
#  - Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=1 and an
#    16-character App Password (Google Account -> Security -> App passwords).
#    A normal Gmail password will NOT work.
#  - Port 465 providers: EMAIL_USE_SSL=1 and EMAIL_USE_TLS=0.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Sansaaric Stay <no-reply@sansaaricstay.com>
# SERVER_EMAIL=Sansaaric Stay <no-reply@sansaaricstay.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=<16-character-app-password>
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=10

# Signup confirmation codes (emailed before a new account can log in).
# EMAIL_VERIFICATION_TIMEOUT_MINUTES=15
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_RESEND_SECONDS=60

# Set to 1 only when the Django API is actually served over HTTPS. Enables
# secure cookies, an SSL redirect, HSTS and the proxy SSL header.
# DJANGO_SSL=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sansaaricstay.com
# DJANGO_HSTS_SECONDS=31536000

# Next.js frontend
# Base URL the frontend container uses to reach the Django API. Outside
# docker-compose (local `npm run dev`) the proxy defaults to
# http://localhost:8000 and this can be left unset.
# BACKEND_URL=http://localhost:8000
# Optional browser-visible base for the frontend's direct API calls.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Set to 1 only when the frontend is served over HTTPS (adds HSTS and
# upgrade-insecure-requests to the CSP). Leave unset for localhost.
# NEXT_PUBLIC_HTTPS=1

# Ingestion worker
# Set to 1 to run the training worker as a thread inside the web process
# (single-process dev convenience). Leave unset when running
# `python manage.py trainworker` as a separate process (recommended).
INGESTION_EMBEDDED_WORKER=

# Set to 1 to load the embedding model and probe the Groq model pool on a
# background thread at startup (removes first-request latency).
PREWARM_PIPELINE=

# Uploads above this size (in MB) are rejected at the docadmin upload form.
MAX_UPLOAD_SIZE_MB=50
